# Local development environment contract
#
# Do not add mnemonic values to this file. Generate a fresh, local-only file
# before running the devnet or integration tests:
#
#   ./scripts/generate-test-env.sh
#
# This creates scripts/.env with owner-only permissions. Delete that generated
# file when it is no longer needed and regenerate it for a new local network.

export PASSWORD=
export VALIDATOR1_MNEMONIC=
export VALIDATOR2_MNEMONIC=
export COMMUNITY_MNEMONIC=
export SIGNER1_MNEMONIC=
export SIGNER2_MNEMONIC=
